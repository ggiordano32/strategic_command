extends SceneTree
## Bakes the overworld town sites into static integer data, per content pack:
##   godot --headless --path . --script res://tools/town_bake.gd -- --pack=rome|west
## writes campaign/data/town_sites_<pack>.gd (read by campaign/ctown.gd, the plan the overworld view and the battle
## map share). Calls the overworld generator (game/campaign/town_plan.gd, TownPlan.generate: the grid-mode site fitted
## to the real coast and slopes from the view's coast field, floats), then writes every region's site as integers in
## centimetres in a local frame (origin the town centre, x east, y south). Floats are allowed here (committed data,
## run once per pack on this machine); nothing at runtime uses them. Record keys: see campaign/ctown.gd.
const CData := preload("res://campaign/cdata.gd")
const PackView := preload("res://game/campaign/pack_view.gd")
const TownPlan := preload("res://game/campaign/town_plan.gd")
const CTown := preload("res://campaign/ctown.gd")

const K := TownPlan.K


func _initialize() -> void:
	var pack := "rome"
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--pack="):
			pack = a.get_slice("=", 1)
	PackView.use_pack(pack)
	var lines: Array = []
	var total := 0
	for r in CData.region_count():
		var rec := bake(r)
		var txt := JSON.stringify(rec)
		total += txt.length()
		lines.append("\t\"%s\": %s," % [str(CData.REGIONS[r]["key"]), txt])
	var path := "res://campaign/data/town_sites_%s.gd" % pack
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string("extends RefCounted\n## Town sites of the %s pack, in decimetres in each town's local frame. GENERATED by tools/town_bake.gd from\n" % pack
		+ "## game/campaign/town_plan.gd (the overworld generator): do not edit by hand, regenerate. Keys: campaign/ctown.gd.\n\n"
		+ "const SITES := {\n" + "\n".join(lines) + "\n}\n")
	f.close()
	print("town_bake ", pack, ": ", CData.region_count(), " sites, ", total, " bytes -> ", path)
	quit(0)


static func _l(p: Vector2, c: Vector2) -> Array:
	return [roundi((p.x - c.x) / K * 100.0), roundi((p.y - c.y) / K * 100.0)]


static func _flat(pl: PackedVector2Array, c: Vector2) -> Array:
	var out: Array = []
	for p in pl:
		out.append_array(_l(p, c))
	return out


static func _u4(v: Vector2) -> Array:
	return [roundi(v.x * 10000.0), roundi(v.y * 10000.0)]


static func _lots(slots: Array, c: Vector2, size: int) -> Array:
	var out: Array = []
	for sl in slots:
		var q: Array = _l(sl[0] as Vector2, c)
		out.append([q[0], q[1], TownPlan.yaw_facing(sl[1] as Vector2), size, int(sl[3]), int(sl[4])])
	return out


static func bake(r: int) -> Dictionary:
	var s := TownPlan.generate(r, true)
	var c: Vector2 = s["c"]
	var rad: PackedFloat32Array = s["rad"]
	var cd: Vector2 = s["cdir"]
	var d := {}
	d["wc"] = [roundi(c.x * 1000.0), roundi(c.y * 1000.0)]
	var radi: Array = []
	for v in rad:
		radi.append(roundi(v / K * 100.0))
	d["rad"] = radi
	var foot: Array = []
	for i in 48:
		var a := TAU * float(i) / 48.0
		var u := Vector2(cos(a), sin(a))
		foot.append_array(_l(c + u * TownPlan.rad_at(rad, a), c))
	d["foot"] = foot
	var shore: Array = s["shore"]
	var sflat: Array = []
	var snorm: Array = []
	for e in shore:
		sflat.append_array(_l((e as Array)[0] as Vector2, c))
		var nv: Vector2 = (e as Array)[1]
		snorm.append_array([roundi(nv.x * 1000.0), roundi(nv.y * 1000.0), int((e as Array)[2])])
	d["shore"] = sflat
	d["shore_n"] = snorm
	d["mouth0"] = []
	d["mouth1"] = []
	if bool(s["near_sea"]) and shore.size() >= 3:
		var n := shore.size()
		var sa := (((shore[0] as Array)[0] as Vector2) - c).dot(cd)
		var sb := (((shore[n - 1] as Array)[0] as Vector2) - c).dot(cd)
		var far_end := 0 if sa > sb else n - 1
		d["mouth0"] = _l((shore[far_end] as Array)[0] as Vector2, c)
		d["mouth1"] = _l((shore[n - 1 - far_end] as Array)[0] as Vector2, c)
	var fp: Vector2 = s["fort"]
	d["high"] = _l(fp, c) if fp != Vector2.ZERO else []
	d["sea_dir"] = (roundi(atan2(-cd.y, cd.x) / TAU * 1024.0) & 1023) if cd != Vector2.ZERO else -1
	var lines: Array = []
	for ln in s["streets"]:
		lines.append(_flat(ln, c))
	d["lines"] = lines
	var rr: Array = []
	for ln in s["ring_road"]:
		rr.append(_flat(ln, c))
	d["ring_road"] = rr
	d["lots"] = _lots(s["slots"], c, 30)
	d["ring"] = _lots(s["ring"], c, 44)
	var steep: Array = []
	for i in 16:
		var a2 := TAU * float(i) / 16.0
		var q := c + Vector2(cos(a2), sin(a2)) * TownPlan.R_FULL_M * K * 0.7
		steep.append(1 if TownPlan._slope(q) > 30.0 else 0)
	d["steep"] = steep
	var bytes := PackedByteArray()
	bytes.resize(CTown.COAST_N * CTown.COAST_N / 8)
	for iy in CTown.COAST_N:
		for ix in CTown.COAST_N:
			var p := c + Vector2((float(ix) - 23.5) * 25.0, (float(iy) - 23.5) * 25.0) * K
			if TownPlan.depth_f(p) > 0.0:
				var bi := iy * CTown.COAST_N + ix
				bytes[bi >> 3] = bytes[bi >> 3] | (1 << (bi & 7))
	d["coast"] = Marshalls.raw_to_base64(bytes)
	d["cdir"] = _u4(cd)
	d["cdist"] = roundi(float(s["cdist"]) / K * 100.0) if float(s["cdist"]) < 1e8 else -1
	d["near_sea"] = 1 if bool(s["near_sea"]) else 0
	d["hill"] = 1 if bool(s["hill"]) else 0
	d["up"] = _u4(s["up"])
	d["axis"] = _u4(s["axis"])
	d["church"] = _l(s["church"], c)
	d["church_dir"] = _u4(s["church_dir"])
	d["p0"] = _l(s["p0"], c)
	d["clear_r"] = roundi(float(s["clear_r"]) / K * 100.0)
	var fl: Array = []
	for f in s["fields"]:
		var fd: Dictionary = f
		var q2: Array = _l(fd["ctr"], c)
		var row: Vector2 = fd["row"]
		fl.append([q2[0], q2[1], roundi(row.x * 10000.0), roundi(row.y * 10000.0), roundi(float(fd["hl"]) / K * 100.0), roundi(float(fd["hw"]) / K * 100.0), 1 if bool(fd["orchard"]) else 0])
	d["fields"] = fl
	return d
