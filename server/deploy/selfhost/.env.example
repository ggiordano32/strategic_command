# Copy to .env. Everything is optional except SC_DOMAIN for the caddy profile.

# If set, players need this key to create a campaign (joining needs no key).
SC_INVITE_KEY=

# Origins of web pages allowed to use this server, comma separated, or * for any.
# For the game on itch.io: https://html-classic.itch.zone,https://*.itch.zone
# (https://*.itch.zone matches any subdomain, not itch.zone itself). Native/desktop clients need nothing.
SC_ALLOWED_ORIGINS=

# Caddy profile only: the domain Caddy gets a certificate for.
SC_DOMAIN=

# Shown on the server's root page: where the game can be played.
SC_GAME_URL=

# Optional: host port (default 8060) and image tag (default latest).
#SC_PORT=8060
#SC_TAG=latest
